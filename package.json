{
  "name": "telinha",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:desktop": "npx tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:server": "npm run build --prefix server && npm start --prefix server",
    "lint": "eslint src",
    "tauri": "npx tauri",
    "server": "npm run dev --prefix server",
    "dev:all": "concurrently \"npm run server\" \"npm run tauri dev\"",
    "dev:solo": "concurrently \"npm run server\" \"npm run dev -- --host 127.0.0.1\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
