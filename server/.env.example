PORT=3001
HOST=0.0.0.0
# URL pública do WebSocket em produção. Sem isso o servidor confia em Host/X-Forwarded-Proto.
# WS_PUBLIC_URL=https://telinha-server.onrender.com
# TRUST_PROXY=1
# Origens web adicionais separadas por vírgula. Tauri e localhost já são permitidos.
# CORS_ORIGINS=https://telinha.example.com
# Durante a migração para o protocolo 2, mantenha 1; depois de distribuir o app 0.2.0, use 2.
MIN_PROTOCOL_VERSION=2
